{
  "title": "Internet link capacity (Ookla speedtest): can it run the site?",
  "description": "Option A of the NDM WAN bandwidth demo: the Ookla speedtest community integration, graded against 50 Mbps per direction.",
  "widgets": [
    {
      "id": 1751260859427132,
      "definition": {
        "title": "Can the internet link carry the site? (bar: 50 Mbps each way)",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 1823546838088659,
            "definition": {
              "type": "note",
              "content": "The Ookla speedtest runs every 15 minutes over the Agent's **real internet path**. Each direction is graded separately: it **passes** at 47.5 Mbps or more (95% of 50, the same tolerance as the iperf3 check).",
              "background_color": "transparent",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 1
            }
          },
          {
            "id": 7985949330612476,
            "definition": {
              "title": "DOWNLOAD: 1 = PASS, 0 = FAIL",
              "title_align": "center",
              "time": {},
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:speedtest.download.bandwidth.bit_per_sec{site:demo}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "clamp_max(clamp_min(q1 - 47500000 + 1, 0), 1)",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit"
                        }
                      }
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 1,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": "<",
                      "value": 1,
                      "palette": "white_on_red"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "precision": 0
            },
            "layout": {
              "x": 0,
              "y": 1,
              "width": 3,
              "height": 2
            }
          },
          {
            "id": 1329031980667227,
            "definition": {
              "title": "UPLOAD: 1 = PASS, 0 = FAIL",
              "title_align": "center",
              "time": {},
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:speedtest.upload.bandwidth.bit_per_sec{site:demo}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "clamp_max(clamp_min(q1 - 47500000 + 1, 0), 1)",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit"
                        }
                      }
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 1,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": "<",
                      "value": 1,
                      "palette": "white_on_red"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "precision": 0
            },
            "layout": {
              "x": 3,
              "y": 1,
              "width": 3,
              "height": 2
            }
          },
          {
            "id": 4726753170889906,
            "definition": {
              "title": "Download achieved",
              "title_align": "center",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
