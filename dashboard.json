    {
      "id": 4852614893301195,
      "definition": {
        "title": "SNMP correlation: NDM measures, the test generates load",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 8889736428815413,
            "definition": {
              "type": "note",
              "content": "SNMP counters are the **measurement**, and the iperf3 test is only the **load generator**. Between tests the interface sits flat, during a test it climbs to what the circuit actually carries. `snmp.ifHCOutOctets.rate` is octets/second, so **x 8 / 1,000,000** puts it in Mbps on the same axis as iperf3. Pick the circuit with the `circuit` variable at the top.",
              "background_color": "transparent",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 1
            }
          },
          {
            "id": 3879575047262197,
            "definition": {
              "title": "SNMP utilization of circuit capacity (ifBandwidthOutUsage, % of ifHighSpeed)",
              "show_legend": true,
              "legend_layout": "horizontal",
              "legend_columns": [
                "value",
                "max"
              ],
              "time": {},
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "max:snmp.ifBandwidthOutUsage.rate{site:demo,interface:eth0} by {circuit}.rollup(max)"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  },
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "label": "100% of capacity",
                  "value": "y = 100",
                  "display_type": "error dashed"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 1,
              "width": 6,
              "height": 3
            }
          },
          {
            "id": 5761249736360005,
            "definition": {
              "title": "$circuit.value: iperf3 test vs SNMP ifHCOutOctets (two independent measurements)",
              "show_legend": true,
              "legend_layout": "horizontal",
              "legend_columns": [
                "value",
                "max"
              ],
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "max:snmp.ifHCOutOctets.rate{$circuit,interface:eth0}.rollup(max)"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1 * 8 / 1000000",
                      "alias": "SNMP ifHCOutOctets (octets/s x 8 -> Mbps)"
                    }
                  ],
                  "style": {
                    "palette": "cool",
                    "line_type": "solid",
                    "line_width": "thick"
                  },
                  "display_type": "area"
                },
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q2",
                      "query": "avg:wan.throughput.mbps{$circuit}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q2",
                      "alias": "iperf3 achieved Mbps"
                    }
                  ],
                  "style": {
                    "palette": "orange",
                    "line_type": "solid",
                    "line_width": "thick"
                  },
                  "display_type": "line"
                },
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q3",
                      "query": "max:snmp.ifHighSpeed{$circuit,interface:eth0}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q3",
                      "alias": "SNMP ifHighSpeed (capacity, Mbps)"
                    }
                  ],
                  "style": {
                    "palette": "grey",
                    "line_type": "dotted",
                    "line_width": "normal"
                  },
                  "display_type": "line"
                },
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q4",
                      "query": "max:wan.throughput.required_mbps{$circuit}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q4",
                      "alias": "required Mbps"
                    }
                  ],
                  "style": {
                    "palette": "red",
                    "line_type": "dashed",
                    "line_width": "normal"
                  },
                  "display_type": "line"
                }
              ]
            },
            "layout": {
