{
  "title": "WAN circuit capacity: can it run the site?",
  "description": "iperf3 generates a fixed 50 Mbps load per circuit, and SNMP interface counters measure it independently.",
  "widgets": [
    {
      "id": 2300957661862984,
      "definition": {
        "title": "Can each circuit carry the site? (minimum 50 Mbps required)",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 7864069954971863,
            "definition": {
              "type": "note",
              "content": "Each circuit is offered **50 Mbps of UDP for 30 s** every two minutes. A circuit **passes** if at least 95% of that arrives with under 1% loss. Cellular is shaped to 30 Mbps, so it **should fail**.",
              "background_color": "transparent",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false,
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 1
            }
          },
          {
            "id": 5343745107023832,
            "definition": {
              "title": "PRIMARY: 1 = PASS, 0 = FAIL",
              "title_align": "center",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "max:wan.throughput.meets_requirement{circuit:primary}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 1,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": "<",
                      "value": 1,
                      "palette": "white_on_red"
                    }
                  ]
                }
              ],
              "autoscale": false,
              "precision": 0
            },
            "layout": {
              "x": 0,
              "y": 1,
              "width": 2,
              "height": 1
            }
          },
